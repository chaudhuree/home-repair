// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  super_admin
  user
  property_manager
  employee
  manager
}

enum ServiceStatus {
  pending
  accepted
  assigned_employee
  in_progress
  work_done
  completed
  cancelled
  success
}

enum PaymentStatus {
  pending
  partially_paid
  total_paid
}

enum OrderPaymentStatus {
  failed
  success
}

enum CashbackStatus {
  pending
  approved
  rejected
}

enum RefundStatus {
  pending
  succeeded
  failed
}

model User {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  email            String    @unique
  password         String
  role             UserRole  @default(user)
  otp              String?
  otpExpiry        DateTime?
  stripeCustomerId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  profile           Profile?
  reservations      Reservation[] @relation("customer")
  assignedJobs      Reservation[] @relation("employee")
  orders            Order[]
  messages          Message[]
  cashbacks         Cashback[]
  supplyAssignments SupplyAssignment[]
  supplyTransactions SupplyTransaction[]
  customerTransactions Transaction[] @relation("transactionCustomer")
  employeeTransactions Transaction[] @relation("transactionEmployee")
  todos             Todo[] @relation("employeeTodos")
}

model Service {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  image       String
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  reservations Reservation[]
  spaceTypes   SpaceType[]
  addOns       AddOn[]
  transactions Transaction[]
}

model SpaceType {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  serviceId   String   @db.ObjectId
  name        String
  description String
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  service      Service    @relation(fields: [serviceId], references: [id])
  reservations Reservation[] @relation("SpaceTypeReservations")
}

model PackageType {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String[]
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reservations Reservation[] @relation("PackageTypeReservations")
}

model AddOn {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  serviceId   String   @db.ObjectId
  name        String
  description String
  price       Float
  quantity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  service      Service    @relation(fields: [serviceId], references: [id])
  reservationAddOns ReservationAddOn[]
}


model Reservation {
  id                      String        @id @default(auto()) @map("_id") @db.ObjectId
  userId                  String        @db.ObjectId
  serviceId               String        @db.ObjectId
  spaceTypeId             String?        @db.ObjectId
  packageTypeId           String?        @db.ObjectId
  employeeId              String?       @db.ObjectId
  stripeCustomerId        String?
  depositPaymentIntentId  String?
  finalPaymentIntentId    String?
  paymentMethodId         String?
  refundId                String?
  refundStatus            RefundStatus?
  providePaint            Boolean       @default(false)
  paintPrice              Float?        @default(0)
  paintName               String?
  status                  ServiceStatus @default(pending)
  customersGivenImages    String[]
  beforeImages            String[]
  afterImages             String[]
  projectDescription      String?
  accessInstructionDetails String?
  address                 Address
  userSelectedDates       DateTime[]
  scheduledDate           DateTime?
  workStartTime           DateTime?
  workEndTime             DateTime?
  amount             Float
  firstInstallmentAmount  Float?
  secondInstallmentAmount Float?
  firstInstallmentPaid    Boolean       @default(false)
  secondInstallmentPaid   Boolean       @default(false)
  paymentStatus           PaymentStatus @default(pending)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  // Relations
  user         User        @relation("customer", fields: [userId], references: [id])
  employee     User?       @relation("employee", fields: [employeeId], references: [id])
  service      Service     @relation(fields: [serviceId], references: [id])
  spaceType    SpaceType?  @relation("SpaceTypeReservations", fields: [spaceTypeId], references: [id])
  packageType  PackageType? @relation("PackageTypeReservations", fields: [packageTypeId], references: [id])
  reservationAddOns ReservationAddOn[]
  order        Order?
  chatRoom     ChatRoom?
  cashbacks    Cashback[]
  transactions Transaction[]
  checklist    ReservationChecklist?
}


model Profile {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @unique @db.ObjectId
  firstName  String
  lastName   String
  contactNo  String?
  address    String?
  bio        String?
  profileImg String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id])
}

model Order {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  reservationId String             @unique @db.ObjectId
  userId        String             @db.ObjectId
  totalAmount   Float
  paymentIntent String?
  paymentStatus OrderPaymentStatus
  currency      String             @default("USD")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Relations
  user        User        @relation(fields: [userId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])
}

model ChatRoom {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String // Format: customerName_serviceName-dateOfBooking
  reservationId String   @unique @db.ObjectId
  participants  String[] @db.ObjectId // Array of User IDs
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  reservation Reservation @relation(fields: [reservationId], references: [id])
  messages    Message[]
}

model Message {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  chatRoomId String   @db.ObjectId
  senderId   String   @db.ObjectId
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id])
  sender   User     @relation(fields: [senderId], references: [id])
}

type Address {
  streetAddress      String
  apartmentSuitUnit  String
  city               String
  state              String
}

model ReservationAddOn {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  reservationId String      @db.ObjectId
  addOnId       String      @db.ObjectId
  quantity      Int

  reservation   Reservation @relation(fields: [reservationId], references: [id])
  addOn         AddOn       @relation(fields: [addOnId], references: [id])
}

model Cashback {
  id                     String         @id @default(auto()) @map("_id") @db.ObjectId
  userId                 String         @db.ObjectId
  reservationId          String         @db.ObjectId
  amount                 Float
  status                 CashbackStatus @default(pending)
  proof                  String[]
  depositPaymentIntentId String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  // Relations
  user        User        @relation(fields: [userId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])
}

model Supply {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  category    String
  measureUnit String
  quantity    Int
  status      Boolean  @default(true) // true = available, false = not available
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  supplyAssignments SupplyAssignment[]
  supplyTransactions SupplyTransaction[]
}

model SupplyAssignment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  supplyId  String   @db.ObjectId
  userId    String   @db.ObjectId
  quantity  Int
  isReturned Boolean  @default(false)
  assignDate DateTime @default(now())
  returnDate DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  supply Supply @relation(fields: [supplyId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

enum SupplyTransactionType {
  assigned
  returned
}

model SupplyTransaction {
  id               String               @id @default(auto()) @map("_id") @db.ObjectId
  supplyId         String               @db.ObjectId
  employeeId       String               @db.ObjectId
  quantity         Int
  type             SupplyTransactionType
  date             DateTime             @default(now())
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  // Relations
  supply           Supply               @relation(fields: [supplyId], references: [id])
  employee         User                 @relation(fields: [employeeId], references: [id])
}

enum PaymentType {
  first_installment
  second_installment
  expense
  refunded
  cashback
}

enum PaymentMethod {
  credit_card
  debit_card
  cash
  bank_transfer
  stripe
  paypal
  other
}

model Transaction {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  transactionId String        @unique
  date          DateTime      @default(now())
  reservationId String?       @db.ObjectId
  serviceId     String?       @db.ObjectId
  employeeId    String?       @db.ObjectId
  customerId    String        @db.ObjectId
  amount        Float
  paymentMethod PaymentMethod
  paymentType   PaymentType
  status        String?       // For tracking transaction status (e.g., successful, failed, pending)
  addOnsList    String[]      @db.ObjectId // Array of AddOn IDs
  description   String?       // Detailed description of the transaction
  notes         String?       
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  reservation   Reservation?  @relation(fields: [reservationId], references: [id])
  service       Service?      @relation(fields: [serviceId], references: [id])
  employee      User?         @relation("transactionEmployee", fields: [employeeId], references: [id])
  customer      User          @relation("transactionCustomer", fields: [customerId], references: [id])
}

model Todo {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  employeeId  String     @db.ObjectId
  date        DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  employee    User       @relation("employeeTodos", fields: [employeeId], references: [id])
  todoItems   TodoItem[]
}

model TodoItem {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  todoId      String     @db.ObjectId
  content     String
  isDone      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  todo        Todo       @relation(fields: [todoId], references: [id])
}

model ReservationChecklist {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  reservationId String   @unique @db.ObjectId
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  items         ChecklistItem[]
}

model ChecklistItem {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  reservationChecklistId String   @db.ObjectId
  description         String
  isDone              Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  reservationChecklist ReservationChecklist @relation(fields: [reservationChecklistId], references: [id])
}
